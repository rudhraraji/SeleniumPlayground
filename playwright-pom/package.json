{
  "name": "playwright-pom",
  "version": "1.0.0",
  "description": "A Playwright TypeScript Page Object Model framework for testing.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:report": "playwright test --reporter=html",
    "show:report": "playwright show-report",
    "test:allure": "playwright test --reporter=html,line,allure-playwright",
    "test:jira": "node scripts/jira-test.mjs",
    "jira:prompt": "node scripts/jira-prompt.mjs",
    "jira:credential:save": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/jira-credential.ps1 save",
    "allure:generate": "allure generate ./allure-results --output allure-report",
    "allure:open": "allure open allure-report",
    "build": "tsc"
  },
  "dependencies": {
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^14.0.0",
    "allure": "^3.18.0",
    "allure-playwright": "^3.11.0",
    "typescript": "^4.9.5"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "config": {
    "url": "https://www.testmuai.com/login"
  }
}
